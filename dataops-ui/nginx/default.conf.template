server {
    listen 80;
    # The image's 10-listen-on-ipv6-by-default.sh only patches the *packaged*
    # default.conf; it skips ours ("differs from the packaged version"), so IPv6
    # has to be declared here. Without it `localhost` (which resolves to ::1
    # first) is refused inside the container — which is what made the healthcheck
    # fail and, in turn, held back cloudflared's depends_on.
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Behind the Cloudflare tunnel nginx always sees plain http, so the
    # visitor's real scheme arrives in X-Forwarded-Proto. If a proxied request
    # came in over http, redirect: without HTTPS the browser withholds
    # crypto.subtle and keycloak-js fails with "Web Crypto API is not
    # available".
    #
    # Deliberately keyed on the header being *present and http* — a direct
    # request to the loopback publish has no X-Forwarded-Proto and is left
    # alone, since localhost is already a secure context.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # Reverse-proxy the DataOps Orchestrator API under this origin.
    #
    # The UI is a static bundle, so the *browser* calls the API — which means
    # the API has to be reachable from the user's machine. Proxying it here
    # instead of exposing it means the orchestrator stays on the internal
    # network, never published and never in public DNS, and the browser only
    # ever talks to one origin. That removes three problems at once:
    #   - mixed content: an https page cannot call an http:// API;
    #   - CORS: same origin, so the orchestrator needs no CORS_ORIGINS entry;
    #   - a second tunnel hostname and Keycloak origin for the API.
    #
    # This is guidelines §27 option 3 ("proxy API requests through Nginx and use
    # a relative /api base URL"), so set VITE_ORCHESTRATOR_URL=/api.
    location /api/ {
        # Docker's embedded DNS. Resolving through a *variable* upstream is
        # deliberate: with a literal proxy_pass hostname, nginx resolves it at
        # start-up and refuses to boot with "host not found in upstream" if the
        # orchestrator is not running yet.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $orchestrator "${ORCHESTRATOR_UPSTREAM}";

        # Strip the /api prefix with an explicit rewrite rather than relying on
        # proxy_pass's trailing slash.
        #
        # That trailing-slash substitution ONLY works when proxy_pass has a
        # literal URI. With a variable upstream (needed above so nginx does not
        # resolve the host at start-up), nginx sends the proxy_pass URI verbatim
        # and discards the request path — so `proxy_pass $orchestrator/` sent
        # every call upstream as `GET /`, which the API answered with 404.
        #
        # `rewrite ... break` rewrites $uri to /dags and stops processing;
        # proxy_pass with no URI part then forwards the rewritten $uri. The
        # original query string is preserved automatically because the
        # replacement contains no '?'.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $orchestrator;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # The Authorization header must survive: the API is Keycloak-protected.
        proxy_pass_request_headers on;

        # Uploads: dataset files go through this path.
        client_max_body_size 512m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Single page app.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Runtime configuration must never be cached, or a deploy-time URL change
    # would not reach browsers that already hold the old file.
    location = /config.js {
        add_header Cache-Control "no-store, must-revalidate";
        expires -1;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # §25 hardening.
    #
    # ${KEYCLOAK_ORIGIN} is substituted at container start (see the Dockerfile's
    # /etc/nginx/templates mechanism). It must be present in BOTH:
    #   connect-src — keycloak-js fetches the token endpoint. The orchestrator
    #                 API is same-origin when proxied via /api above, so it
    #                 needs no entry; ${ORCHESTRATOR_ORIGIN} is kept only for
    #                 deployments that still call it cross-origin (leave empty
    #                 otherwise).
    #   frame-src   — `check-sso` loads a hidden iframe pointed at Keycloak,
    #                 and Keycloak's prompt=none response REDIRECTS that iframe
    #                 back to /silent-check-sso.html on this origin. CSP is
    #                 enforced on the redirect target too, so 'self' is required
    #                 as well as the IdP — omitting it fails as
    #                 ERR_BLOCKED_BY_CSP reported against the auth URL.
    # With a bare `default-src 'self'` both are blocked and login fails, which
    # is not obvious from the symptom.
    #
    # 'unsafe-inline' is needed for style-src only, because of index.html's
    # pre-paint background block.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${KEYCLOAK_ORIGIN} ${ORCHESTRATOR_ORIGIN}; frame-src 'self' ${KEYCLOAK_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_ORIGIN}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
}
