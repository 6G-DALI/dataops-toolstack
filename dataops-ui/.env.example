# Base URL of the DataOps Orchestrator (no trailing slash)
VITE_ORCHESTRATOR_URL=http://localhost:8000

# Base URL of the piveau catalogue browsing frontend (no trailing slash) —
# used to build "View in catalogue" links as <base>/datasets/<datasetId>
VITE_CATALOGUE_BASE_URL=http://localhost:8080

# The 6G-DALI tool suite, linked from the navbar. Each link is shown only when
# its variable is set (no trailing slash).
VITE_DALI_URL=https://6gdali.eu
VITE_DATASPACE_URL=https://dspace.sparkworks.net
VITE_DATAOPS_URL=https://dataops.dali.sparkworks.net
VITE_MLOPS_URL=https://mlops.dali.sparkworks.net
