# Configuration for the DataOps UI.
#
# In a container these VITE_* names are read at *start-up* by
# docker-entrypoint.d/40-dataops-config.sh, which regenerates config.js — so
# `docker compose up -d` applies a change with no rebuild. In local development
# (`npm run dev`) the same names are read by Vite at build time.
#
# The names are shared with the portal, so one set configures both front ends.
# Leave a tool URL unset to drop its navbar link rather than point at nothing.

# Required: base URL of the DataOps Orchestrator (no trailing slash)
VITE_ORCHESTRATOR_URL=http://localhost:8000

# piveau catalogue front end — dataset links are built as <base>/datasets/<id>
VITE_CATALOGUE_BASE_URL=http://localhost:8080

# Portal base URL. The navbar username links to <base>/#/account, the single
# account page for the whole SSO environment.
VITE_PORTAL_URL=http://localhost:3100

# Shared 6G-DALI tool suite — the navbar links
VITE_DALI_URL=https://6gdali.eu/
VITE_DATASPACE_URL=
VITE_DATAOPS_URL=
VITE_MLOPS_URL=

# Single sign-on — realm/host must match the other DALI front ends
# Shared name across every 6G-DALI front end (was VITE_KEYCLOAK_URL).
VITE_AUTH_URL=https://auth.dspace.sparkworks.net/auth
VITE_KEYCLOAK_REALM=dspace
VITE_KEYCLOAK_CLIENT_ID=dataops-ui

# ─── Container-only (not read by the bundle) ─────────────────────────────────
# Substituted into the nginx CSP at start-up. Must be scheme + host, no path.
# A mismatch blocks login/API calls with only a console CSP violation to show.
KEYCLOAK_ORIGIN=https://auth.dspace.sparkworks.net
ORCHESTRATOR_ORIGIN=http://localhost:8000
